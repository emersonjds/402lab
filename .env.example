# apps/api/.env — copy to .env and fill. Never commit .env.
PORT=8080
LOG_LEVEL=info
FACILITATOR_URL=https://x402.org/facilitator
# Public address (base58) that receives every x402 payment.
TREASURY_ADDRESS=
DATABASE_URL=postgres://lab:lab@localhost:5432/lab402

# scripts/devnet-pay.ts
API_URL=http://localhost:8080
# Path to a solana-keygen JSON keypair (64-byte array) for the payer. Keep it under scripts/.wallets/.
PAYER_KEYPAIR_PATH=scripts/.wallets/payer.keypair.json
