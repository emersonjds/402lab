# apps/api/.env — copy to .env and fill. Never commit .env.
PORT=8080
LOG_LEVEL=info
FACILITATOR_URL=https://x402.org/facilitator
# Public address (base58) that receives every x402 payment.
TREASURY_ADDRESS=
# Split recipients (public base58 addresses): one provider per service, the integrator.
# The platform share stays in TREASURY_ADDRESS.
PROVIDER_OCR_ADDRESS=
PROVIDER_TRANSLATE_ADDRESS=
PROVIDER_SUMMARIZE_ADDRESS=
INTEGRATOR_ADDRESS=

# Upstreams. A service runs live only when all of its keys are set; otherwise it answers
# in demo mode (deterministic, no network). Blank = off.
# OCR — Azure AI Vision (Image Analysis 4.0 Read), e.g. https://<name>.cognitiveservices.azure.com/
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=
# Translate — AWS Translate. Live needs AWS_REGION and AWS_ACCESS_KEY_ID; the SDK reads
# AWS_SECRET_ACCESS_KEY (and AWS_SESSION_TOKEN) through its default credential chain.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Summarize — Anthropic (claude-haiku-4-5).
ANTHROPIC_API_KEY=
DATABASE_URL=postgres://lab:lab@localhost:5432/lab402

# scripts/devnet-pay.ts
API_URL=http://localhost:8080
# Path to a solana-keygen JSON keypair (64-byte array) for the payer. Keep it under scripts/.wallets/.
PAYER_KEYPAIR_PATH=scripts/.wallets/payer.keypair.json
