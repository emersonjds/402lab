{
  "name": "402lab",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "spike:pay": "tsx --env-file-if-exists=apps/api/.env scripts/devnet-pay.ts",
    "e2e:devnet": "tsx --env-file-if-exists=apps/api/.env scripts/e2e-devnet.ts",
    "traffic:devnet": "tsx --env-file-if-exists=apps/api/.env scripts/agent-traffic.ts",
    "db:up": "docker compose up -d postgres",
    "docker:up": "docker compose up --build -d postgres api web",
    "docker:mock": "docker compose --profile mock up --build -d web-mock",
    "docker:down": "docker compose --profile mock down",
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w @402lab/api\" \"npm run dev -w @402lab/web\"",
    "dev:mobile": "npm run start -w @402lab/mobile",
    "smoke": "node scripts/smoke.ts"
  },
  "devDependencies": {
    "@402lab/shared": "*",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "@solana/kit": "8.4.0",
    "@types/node": "^26.4.1",
    "@x402/core": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/svm": "2.28.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "zod": "^4.6.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
