{
  "expo": {
    "name": "402Lab",
    "slug": "402lab",
    "scheme": "lab402",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D10",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.lab402.mobile"
    },
    "android": {
      "package": "app.lab402.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "402Lab uses the camera only to scan the pairing code on your dashboard.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B6F23A"
        }
      ]
    ]
  }
}
