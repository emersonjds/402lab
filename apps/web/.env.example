# API behind the same-origin /api proxy (session cookie stays first-party).
API_URL=http://localhost:8080
# Public origin for metadata and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API origin reachable from the paired phone, e.g. http://192.168.1.20:8080. Encoded into the
# "Pair your phone" QR so a mobile device on the same network can reach the API directly.
NEXT_PUBLIC_API_PUBLIC_URL=http://localhost:8080
# Solana RPC for wallet balance reads and the recharge transaction. Devnet by default.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# "enabled" runs the whole panel on @402lab/mocks (MSW) fixtures instead of the real API — no
# devnet USDC needed. Also registers a mock Wallet Standard provider so Connect wallet works
# without a real Phantom/Solflare extension. Unset or any other value: calls the real API.
NEXT_PUBLIC_API_MOCKING=
